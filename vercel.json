{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html",  "use": "@vercel/static" },
    { "src": "public/**",   "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/fotos",   "dest": "/api/fotos.js" },
    { "src": "/photos/(.*)", "dest": "/public/photos/$1" },
    { "src": "/(.*)",        "dest": "/index.html" }
  ]
}